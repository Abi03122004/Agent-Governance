# =============================================================================
# Autonomous AI Agent Security & Runtime Governance Platform
# Environment Configuration Example (NO REAL SECRETS)
# =============================================================================

# Application Environment: development | staging | production | testing
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
SERVICE_NAME=agent-governance-platform

# Security & Cryptography
# Note: In production, SECRET_KEY must be >= 32 characters and cryptographically random
SECRET_KEY=dev_insecure_secret_key_change_in_production_min32chars
SESSION_TOKEN_TTL_SECONDS=3600
APPROVAL_TICKET_TTL_SECONDS=900
ENABLE_FAIL_SECURE=true

# Database Persistence (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_governance
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Distributed Cache & Budget Locks (Redis)
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=2.0

# CORS Configuration (Comma-separated in production, no wildcards allowed)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Observability
LOG_LEVEL=INFO
