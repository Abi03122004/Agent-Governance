ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
# Replace this value outside local development. Never commit a real secret.
SECRET_KEY=replace-with-a-local-development-secret-at-least-32-characters
DATABASE_URL=postgresql+asyncpg://agent_governance:agent_governance@postgres:5432/agent_governance
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000
EXECUTION_AUTH_TTL_SECONDS=120
ALLOW_DEV_HEADER_AUTH=true
